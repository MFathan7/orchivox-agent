{
  "name": "orchivox-agent",
  "version": "0.2.0",
  "description": "Personal AI coding agent runtime: IDE-grade code editing, isolated Git worktree subagents, time-traveling stream rules, and a dual-direction OpenAPI and OpenClaude gateway.",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.1.0"
  },
  "bin": {
    "orchivox": "./bin/orchivox.js",
    "orchvox": "./bin/orchivox.js"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "serve": "bun run src/server.ts",
    "test": "bun test",
    "build:binary": "bun run scripts/build-binary.ts",
    "install:global": "bun run scripts/install-global.ts",
    "check:secrets": "bun run scripts/check-secrets.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@scalar/hono-api-reference": "^0.12.13",
    "chalk": "^6.0.1",
    "diff": "^9.0.0",
    "get-east-asian-width": "^1.7.0",
    "hono": "^4.13.13",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^18.3.31",
    "typescript": "^5.9.3"
  }
}
